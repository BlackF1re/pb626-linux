&reg_elan_touch {
  regulator-min-microvolt = <3300000>;
  regulator-max-microvolt = <3300000>;
  vin-supply = <&reg_vcc3v3>;
};

&{/soc/i2c@1c2b400/touchscreen@15} {
  compatible = "elan,ektf2227";
  /delete-property/ vcc33-supply;
  /delete-property/ vccio-supply;
  /delete-property/ touchscreen-size-x;
  /delete-property/ touchscreen-size-y;
  /* Factory type 8 selects 3.3 V, disables 1.8 V and leaves FPC flash off. */
  mode-gpios = <&pio 3 27 GPIO_ACTIVE_HIGH>,
               <&pio 3 25 GPIO_ACTIVE_HIGH>,
               <&pio 3 26 GPIO_ACTIVE_HIGH>;
  vcc-supply = <&reg_elan_touch>;
};
