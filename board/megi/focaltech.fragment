/ {
  /* PE5 touch switch, also present on the shared factory board FEX. */
  reg_focal_touch: regulator-focal-touch {
    compatible = "regulator-fixed";
    regulator-name = "vdd-focal-touch";
    regulator-min-microvolt = <1800000>;
    regulator-max-microvolt = <1800000>;
    gpio = <&pio 4 5 GPIO_ACTIVE_LOW>;
    vin-supply = <&reg_1v8_ctp>;
  };
};
/* Stock type 18: FT5X/CY8CTMA30; factory uses ft5x_xc3.ko.
 * The EDT FT5206 protocol is experimental, not verified on this model.
 */
&i2c2 {
  /delete-node/ touchpanel@24;
  touchscreen@24 {
    compatible = "edt,edt-ft5206";
    reg = <0x24>;
    interrupt-parent = <&pio>;
    interrupts = <6 11 IRQ_TYPE_EDGE_FALLING>;
    reset-gpios = <&pio 1 3 GPIO_ACTIVE_LOW>;
    vcc-supply = <&reg_focal_touch>;
    touchscreen-size-x = <1024>;
    touchscreen-size-y = <758>;
  };
};
