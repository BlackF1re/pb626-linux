/* Compose AFTER elan, elan-display and elan-ektf2227.
 * Preserve the proven display/USB/touch wiring; allow the internal MMC only.
 */
&mmc0 {
  status = "disabled";
};
&mmc2 {
  max-frequency = <25000000>;
  no-sd;
  no-sdio;
  status = "okay";
};
&{/chosen} {
  pb626,emmc-root;
  bootargs = "console=ttyS0,115200 root=/dev/mmcblk2p1 rootfstype=ext4 rootwait ro init=/sbin/init";
  /delete-property/ linux,initrd-start;
  /delete-property/ linux,initrd-end;
  /delete-property/ pb626,emmc-backup;
};

/* Native UI exposes every percent of the existing linear PWM range.
 * Keep zero on first boot and leave the tested pin-off sequence intact. */
&{/backlight} {
  num-interpolated-steps = <10>;
};
