/* PB626 / Touch Lux 3 first-stage hardware diagnostic.
 *
 * Manufacturer firmware on the observed ELAN revision:
 *  - USB works with PG1 as a VBUS-detect input
 *  - frontlight can be switched fully off through manufacturer controls
 *
 * KEEP the stock PG1 USB VBUS detection unmodified. Only isolate the
 * frontlight-enable PB4 and PWM path, to see if uncontrolled light stops.
 * This must never be used as a production DTB.
 */
&{/backlight} {
  status = "disabled";
};

&pwm {
  status = "disabled";
};

&pio {
  pb626_frontlight_off: frontlight-enable-hog {
    gpio-hog;
    gpios = <1 4 GPIO_ACTIVE_HIGH>; /* PB4 output-low: hypothesis */
    output-low;
    line-name = "pb626-frontlight-forced-off";
  };
};
