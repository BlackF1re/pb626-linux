/* ELAN / ED060XD4 display bring-up from RAM, with USB ACM diagnostics. */
&mmc0 {
  status = "disabled";
};

&pio {
  pb626_backlight_off: pb626-backlight-off-pins {
    pins = "PB2";
    function = "gpio_in";
    bias-disable;
  };
};

&pwm {
  /delete-property/ pinctrl-names;
  /delete-property/ pinctrl-0;
};

/* The factory driver subtracts brightness from the active-low duty.
 * Express the same increasing high time directly with pwm-backlight.
 * In the off state disconnect PWM so PB4 can hold the control line low.
 */
&{/backlight} {
  pinctrl-names = "default", "pwm-on";
  pinctrl-0 = <&pb626_backlight_off>;
  pinctrl-1 = <&pwm0_pin>;
  pwms = <&pwm 0 100000 0>;
  /delete-property/ lth-brightness;
  post-pwm-on-delay-ms = <1>;
  pwm-off-delay-ms = <1>;
};

/* Keep the peripheral-only VBUS fallback proven by elan-usbtest. */
&usbphy {
  /delete-property/ usb0_vbus_det-gpios;
};

&{/chosen} {
  pb626,display-bringup;
};
