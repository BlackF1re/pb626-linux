/* ELAN / ED060XD4 display bring-up from RAM, with USB ACM diagnostics. */
&mmc0 {
  status = "disabled";
};

/* Match the factory TPS61161 driver: PWM0 at 10 kHz with active-low duty.
 * PB4 gates the light after PWM starts and before PWM stops.
 */
&{/backlight} {
  pwms = <&pwm 0 100000 PWM_POLARITY_INVERTED>;
  post-pwm-on-delay-ms = <1>;
  pwm-off-delay-ms = <1>;
};

/* Keep the peripheral-only VBUS fallback proven by elan-usbtest. */
&usbphy {
  /delete-property/ usb0_vbus_det-gpios;
};

&{/chosen} {
  pb626,display-bringup;
};
