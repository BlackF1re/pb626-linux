[Unit]
Description=Prepare PocketBook E Ink sleep image and restore desktop on resume
After=pb626-desktop.service
Before=systemd-suspend.service
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=125
TimeoutStopSec=115
ExecStart=/usr/bin/pb626-x11-epd --sleep-prepare
# The current kernel's STREAMOFF delays rail shutdown by 5 seconds.
ExecStartPost=/bin/sleep 6
ExecStopPost=-/usr/bin/pb626-x11-epd --sleep-resume
