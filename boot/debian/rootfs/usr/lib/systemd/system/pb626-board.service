[Unit]
Requires=pb626-boot-select.service
After=pb626-boot-select.service
ConditionPathExists=/run/pb626-normal-boot
Description=PocketBook board state
ConditionPathExists=/proc/device-tree/chosen/pb626,emmc-root
After=local-fs.target systemd-udev-trigger.service
Before=pb626-desktop.service

[Service]
Type=oneshot
RemainAfterExit=yes
StateDirectory=pb626
StateDirectoryMode=0700
ExecStart=/usr/sbin/pb626-admin restore-board

[Install]
WantedBy=multi-user.target
