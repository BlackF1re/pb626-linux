[Unit]
Description=Draw the persistent PocketBook power-off screen
DefaultDependencies=no
ConditionPathExists=/proc/device-tree/chosen/pb626,emmc-root
ConditionPathExists=/lib/firmware/pb626/default.wbf
After=local-fs.target pb626-desktop.service
Before=shutdown.target poweroff.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/pb626-admin poweroff-screen
# Let STREAMOFF's delayed panel power-off complete before power removal.
ExecStartPost=/bin/sleep 6
TimeoutStartSec=65s

[Install]
WantedBy=poweroff.target
