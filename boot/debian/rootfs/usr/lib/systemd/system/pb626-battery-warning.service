[Unit]
Requires=pb626-boot-select.service
After=pb626-boot-select.service
ConditionPathExists=/run/pb626-normal-boot
Description=Show a low battery warning in the active X11 session
After=pb626-desktop.service
ConditionPathExists=/run/pb626-desktop/ready

[Service]
Type=oneshot
User=reader
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/pb626-desktop/Xauthority
ExecStart=/usr/bin/xmessage -center -timeout 45 -buttons OK:0 "Battery low. Connect the charger and save your work."
TimeoutStartSec=50s
