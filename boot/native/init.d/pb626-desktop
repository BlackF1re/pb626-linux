#!/sbin/openrc-run
description="PocketBook X11 desktop and E Ink renderer"
supervisor=supervise-daemon
command=/sbin/pb626-native-desktop
respawn_delay=5
respawn_max=3
respawn_period=120
output_logger="/usr/bin/logger -t pb626-desktop"
error_logger="/usr/bin/logger -t pb626-desktop"
retry="TERM/15/KILL/5"
depend() {
    need localmount bootmisc pb626-board
    need syslog
    after modules
}
