#!/sbin/openrc-run
description="PocketBook board defaults and frontlight state"
depend() {
    need localmount
    after bootmisc modules
    before pb626-desktop
}
start() {
    ebegin "Applying PocketBook board defaults"
    /usr/sbin/pb626-admin restore-light || ewarn "Frontlight unavailable"
    # The DTS node "led" is the physical PE8 power indicator. Do not
    # disable unrelated LEDs created by USB/network drivers.
    power_led=/sys/class/leds/led
    if [ -w "$power_led/trigger" ]; then
        echo none > "$power_led/trigger" || :
    fi
    eend 0
}
