#!/bin/sh
# Alpine userspace for FEL and installed Linux.
set -u
export PATH=/sbin:/bin:/usr/sbin:/usr/bin HOME=/root TERM=vt100
# The RAM PID 1 enters BusyBox ash directly, without a login session.
# Set a clear interactive prompt and board identity for the USB shell.
hostname pb626 2>/dev/null || true
export PS1='\u@\h:\w\$ '
mkdir -p /dev /proc /sys /run /newroot
mount -t proc proc /proc || exit 1
grep -q ' /dev devtmpfs ' /proc/mounts || mount -t devtmpfs devtmpfs /dev || exit 1
mount -t sysfs sysfs /sys || exit 1
mount -t tmpfs tmpfs /run || exit 1
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null || true
exec >/run/pb626-boot.log 2>&1
log() {
  echo "pb626: $*"
  echo "pb626: $*" >/dev/kmsg 2>/dev/null || true
}
chosen=/sys/firmware/devicetree/base/chosen
boot_source=RAM
[ ! -f "$chosen/pb626,emmc-root" ] || boot_source=eMMC
log "$boot_source Linux reached PID 1, kernel $(uname -r)"
# PE8 LED gives read-only boot status without UART/USB. Do not touch
# other GPIOs or eMMC. Linux triggers are implemented by the kernel.
led_pattern() {
  for led in /sys/class/leds/*; do
    [ -w "$led/trigger" ] || continue
    echo timer > "$led/trigger" 2>/dev/null || true
    echo "$1" > "$led/delay_on" 2>/dev/null || true
    echo "$2" > "$led/delay_off" 2>/dev/null || true
  done
}
led_heartbeat() {
  for led in /sys/class/leds/*; do
    [ -w "$led/trigger" ] && echo heartbeat > "$led/trigger" 2>/dev/null || true
  done
}
# 150/150 = PID1 reached; later LED codes diagnose the gadget stage.
led_pattern 150 150
# The vendor PWM/backlight driver can initialize to a nonzero value even
# when the DTB sets a zero default. Force off, but never turn it on.
for bl in /sys/class/backlight/*; do
  [ -d "$bl" ] || continue
  if [ -w "$bl/brightness" ]; then
    echo 0 > "$bl/brightness" 2>/dev/null || true
  fi
  if [ -w "$bl/bl_power" ]; then
    echo 4 > "$bl/bl_power" 2>/dev/null || true
  fi
  log "frontlight-off attempted: $bl brightness=$(cat "$bl/brightness" 2>/dev/null) power=$(cat "$bl/bl_power" 2>/dev/null)"
done
unsafe=0
emmc_backup=0
if [ -f "$chosen/pb626,emmc-backup" ]; then
  emmc_backup=1
  emmc=
  n=0
  while [ -z "$emmc" ] && [ "$n" -lt 15 ]; do
    for path in /sys/bus/mmc/devices/mmc2:*/block/mmcblk*; do
      [ -b "/dev/${path##*/}" ] && emmc=${path##*/}
    done
    [ -n "$emmc" ] && break
    n=$((n + 1))
    sleep 1
  done
  if [ -n "$emmc" ]; then
    for dev in "/dev/$emmc" "/dev/${emmc}boot0" "/dev/${emmc}boot1" /dev/"${emmc}"gp* /dev/"${emmc}"p*; do
      [ -b "$dev" ] || continue
      if ! blockdev --setro "$dev" || [ "$(blockdev --getro "$dev")" != 1 ]; then
        log "Cannot enforce read-only access to $dev"
        exit 1
      fi
    done
    log "eMMC backup: /dev/$emmc and its block partitions are read-only"
  else
    log "eMMC backup: MMC2 card did not enumerate"
  fi
elif [ "$boot_source" = RAM ]; then
  for type in /sys/block/mmcblk*/device/type; do
    [ -r "$type" ] || continue
    if [ "$(cat "$type")" = MMC ]; then
      unsafe=1
      log "SAFETY ERROR: MMC-type device visible: $type"
    fi
  done
fi
# Modules are included in RAM, so no SD card is required for any driver.
if [ -d "/lib/modules/$(uname -r)" ]; then
  for module in rtl8xxxu cyttsp4_core cyttsp4_i2c elants_i2c edt_ft5x06; do
    modprobe "$module" 2>/dev/null || true
  done
  if [ -f /sys/firmware/devicetree/base/chosen/pb626,display-bringup ]; then
    # E Ink is built in; its probe is controlled by the DTB status.
    (modprobe lima || log "failed to load lima") &
  fi
fi
# Distinct PE8 patterns after the first 30 seconds:
# 100ms on / 900ms off: no UDC controller registered.
# 300ms on / 700ms off: CONFIGFS / ACM gadget setup failed.
# 700ms on / 300ms off: UDC exists, but bind failed.
# 100ms/400ms: UDC bound, but bus remains not attached/unknown.
# 500ms/500ms: bus saw host activity but was not configured.
# heartbeat (double pulse): UDC reached CONFIGURED state.
if mount -t configfs configfs /sys/kernel/config 2>/dev/null ||
   grep -q ' /sys/kernel/config configfs ' /proc/mounts; then
  G=/sys/kernel/config/usb_gadget/pb626
  if [ -d /sys/kernel/config/usb_gadget ] &&
     mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409" "$G/functions/acm.usb0" &&
     echo 0x0525 > "$G/idVendor" &&
     echo 0xa4a7 > "$G/idProduct" &&
     echo 0x02 > "$G/bDeviceClass" &&
     echo 0x02 > "$G/bDeviceSubClass" &&
     echo PB626RAM01 > "$G/strings/0x409/serialnumber" &&
     echo PocketBook > "$G/strings/0x409/manufacturer" &&
     echo "PocketBook $boot_source Linux Console" > "$G/strings/0x409/product" &&
     echo 'USB ACM console' > "$G/configs/c.1/strings/0x409/configuration" &&
     ln -s "$G/functions/acm.usb0" "$G/configs/c.1/acm.usb0"; then
    log "CONFIGFS ACM gadget created"
    (
      n=0
      saw_udc=0
      while [ "$n" -lt 30 ]; do
        for udc in /sys/class/udc/*; do
          [ -d "$udc" ] || continue
          saw_udc=1
          log "UDC detected: ${udc##*/}"
          if echo "${udc##*/}" > "$G/UDC"; then
            log "USB gadget bound to ${udc##*/}"
            # The bind call alone does not imply a physical USB session.
            # Observe the UDC's state without changing USB registers or VBUS.
            (
              n=0
              activity=0
              while [ "$n" -lt 25 ]; do
                state=$(cat "$udc/state" 2>/dev/null || echo unknown)
                case "$state" in
                  configured)
                    log "USB UDC CONFIGURED by host"
                    led_heartbeat
                    exit 0
                    ;;
                  powered|default|addressed|suspended)
                    activity=1
                    ;;
                esac
                n=$((n + 1))
                sleep 1
              done
              if [ "$activity" -eq 1 ]; then
                log "USB UDC did not configure despite host activity"
                led_pattern 500 500
              else
                log "USB UDC bound but no session detected"
                led_pattern 100 400
              fi
            ) &
            exit 0
          fi
          log "USB bind rejected by kernel"
        done
        n=$((n + 1))
        sleep 1
      done
      if [ "$saw_udc" = 1 ]; then
        log "USB UDC exists but bind FAILED"
        led_pattern 700 300
      else
        log "USB UDC controller absent after 30s"
        led_pattern 100 900
      fi
    ) &
  else
    log "CONFIGFS gadget/ACM creation FAILED"
    led_pattern 300 700
  fi
else
  log "CONFIGFS mounting FAILED"
  led_pattern 300 700
fi
# Never auto-probe removable storage. A future persistent rootfs can be
# selected by the explicit pb626.root=sd kernel command-line argument.
external=0
for arg in $(cat /proc/cmdline); do
  [ "$arg" = pb626.root=sd ] && external=1
done
if [ "$external" = 1 ] && [ "$unsafe" = 0 ] && [ "$emmc_backup" = 0 ]; then
  log "Opt-in external removable SD root requested"
  (
    n=0
    while [ "$n" -lt 10 ]; do
      for sysdev in /sys/block/mmcblk*; do
        [ -r "$sysdev/device/type" ] || continue
        [ "$(cat "$sysdev/device/type")" = SD ] || continue
        [ "$(cat "$sysdev/removable" 2>/dev/null)" = 1 ] || continue
        dev=/dev/${sysdev##*/}p1
        [ -b "$dev" ] || continue
        if mount -t ext4 -o ro,noload "$dev" /newroot; then
          if [ "$(cat /newroot/etc/pb626-image-id 2>/dev/null)" = pb626-external-alpine-v1 ] &&
             [ -x /newroot/sbin/pb626-init ]; then
            touch /run/pb626-root-ready
            exit 0
          fi
          umount /newroot || true
        fi
      done
      n=$((n + 1))
      sleep 1
    done
  ) >/run/pb626-sd.log 2>&1 &
  n=0
  while [ "$n" -lt 15 ]; do
    [ -f /run/pb626-root-ready ] && break
    n=$((n + 1))
    sleep 1
  done
  if [ -f /run/pb626-root-ready ]; then
    log "Switching to verified read-only removable rootfs"
    for fs in dev proc sys; do mount -o move "/$fs" "/newroot/$fs"; done
    mount -o move /run /newroot/run
    exec switch_root /newroot /sbin/pb626-init
  fi
  log "External root not available; retaining full RAM root"
fi
log "$boot_source Linux userspace initialized; waiting for gadget UDC"
# Optional per-boot private WLAN configuration. No Wi-Fi credentials
# belong in public source or downloaded CI artifacts. Network startup
# is non-blocking and is skipped unless a local RAM secret is provisioned.
if [ "$emmc_backup" = 0 ] && [ -s /etc/pb626/wpa_supplicant.conf ] && [ -x /usr/sbin/pb626-network ]; then
  /usr/sbin/pb626-network >>/run/pb626-network.log 2>&1 &
fi
cd /root || exit 1
while :; do
  if [ -c /dev/ttyGS0 ]; then
    setsid -c sh -c 'printf "\r\nPB626 %s Linux\r\n" "$1"; cat /run/pb626-boot.log; exec sh -i' sh "$boot_source" </dev/ttyGS0 >/dev/ttyGS0 2>&1 || true
  fi
  sleep 1
done
