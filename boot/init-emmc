#!/bin/sh
# Mount the installed system or bring up the USB console from RAM.
set -eu
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
mount -t devtmpfs devtmpfs /dev
root=/dev/mmcblk2p8
n=0
while [ ! -b "$root" ] && [ "$n" -lt 12 ]; do
  sleep 1
  n=$((n + 1))
done
if [ -b "$root" ] && mount -t ext4 "$root" /newroot; then
  if [ -x /newroot/sbin/pb626-emmc-init ] &&
     [ "$(cat /newroot/etc/pb626-image-id)" = pb626-emmc-alpine-v1 ]; then
    umount /dev
    exec switch_root /newroot /sbin/pb626-emmc-init
  fi
  umount /newroot
fi
umount /dev
exec /sbin/pb626-rescue
