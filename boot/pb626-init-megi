#!/bin/sh
# Kernel modules, power and touch originate from the matching 5.9 build.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin HOME=/root TERM=vt100
hostname pb626-alpine
mkdir -p /dev/pts /media/pb626-config /root
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t vfat -o ro /dev/mmcblk0p2 /media/pb626-config 2>/dev/null || true
# Probing a driver is not equivalent to rendering an E Ink waveform.
for module in sun5ieink r8188eu cyttsp4_core cyttsp4_i2c elants_i2c edt_ft5x06; do
  modprobe "$module" >/dev/null 2>&1 || true
done
if [ -s /media/pb626-config/wifi.conf ]; then
  (
    interface=$(iw dev 2>/dev/null | awk '$1 == "Interface" { print $2; exit }')
    if [ -n "$interface" ]; then
      wpa_supplicant -B -i "$interface" -c /media/pb626-config/wifi.conf &&
        udhcpc -i "$interface" -q -n
    fi
  ) >/run/pb626-network.log 2>&1 &
fi
cd /root || exit 1
while :; do
  if [ -c /dev/ttyGS0 ]; then
    setsid -c sh -c 'printf "\r\nAlpine %s / PB626 Megi (FEL + SD)\r\n" "$(cat /etc/alpine-release)"; exec sh -i' </dev/ttyGS0 >/dev/ttyGS0 2>&1
  fi
  sleep 1
done
