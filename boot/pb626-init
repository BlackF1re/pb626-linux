#!/bin/sh
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
export HOME=/root
export TERM=vt100
hostname pb626-alpine
cd /root
while :; do
    if [ -c /dev/ttyGS0 ]; then
        busybox setsid -c sh -c 'printf "\r\nAlpine Linux %s on PocketBook PB626 (external microSD)\r\n" "$(cat /etc/alpine-release)"; exec sh -i' </dev/ttyGS0 >/dev/ttyGS0 2>&1
    fi
    sleep 1
done
