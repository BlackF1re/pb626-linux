#!/bin/sh
# Alpine PID 1. The RAM initramfs configures USB gadget serial before switch_root.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
export HOME=/root
export TERM=vt100
hostname pb626-alpine
mkdir -p /dev/pts /run /media/pb626-config /root
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t vfat -o ro /dev/mmcblk0p2 /media/pb626-config 2>/dev/null || true

# An optional wifi.conf is created locally on the Windows-visible FAT partition.
if [ -s /media/pb626-config/wifi.conf ]; then
    (
        interface=$(iw dev 2>/dev/null | awk '$1 == "Interface" { print $2; exit }')
        if [ -n "$interface" ]; then
            wpa_supplicant -B -i "$interface" -c /media/pb626-config/wifi.conf &&
                udhcpc -i "$interface" -q -n
        fi
    ) >/run/pb626-network.log 2>&1 &
fi

# No SSH root password or host keys are shipped in the image.
# First provision a password and keys through the local USB serial console.
if [ -f /etc/ssh/ssh_host_ed25519_key ]; then
    mkdir -p /run/sshd
    /usr/sbin/sshd -o PermitRootLogin=yes -o PasswordAuthentication=yes >/run/pb626-sshd.log 2>&1 || true
fi

cd /root || exit 1
while :; do
    if [ -c /dev/ttyGS0 ]; then
        # shellcheck disable=SC2016
        busybox setsid -c sh -c 'printf "\r\nAlpine %s (PB626, external microSD)\r\n" "$(cat /etc/alpine-release)"; exec sh -i' </dev/ttyGS0 >/dev/ttyGS0 2>&1
    fi
    sleep 1
done
