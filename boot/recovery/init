#!/bin/sh
# Minimal Debian-package RAM recovery. Never mount or enable writes to MMC.
set -eu
export PATH=/bin:/sbin:/usr/bin:/usr/sbin HOME=/root TERM=vt100
export PS1='PB626 recovery # '
fatal() { echo "PB626 recovery: $*" >/dev/kmsg; while :; do sleep 60; done; }
mount -t proc proc /proc || fatal proc
grep -q ' /dev devtmpfs ' /proc/mounts || mount -t devtmpfs devtmpfs /dev || fatal devtmpfs
mount -t sysfs sysfs /sys || fatal sysfs
mount -t tmpfs -o mode=0755,size=24m tmpfs /run || fatal run
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts || fatal devpts
test -f /sys/firmware/devicetree/base/chosen/pb626,emmc-backup || fatal 'wrong DTB'
test ! -e /sys/firmware/devicetree/base/chosen/pb626,emmc-root || fatal 'native DTB'
disk=/dev/mmcblk2
for n in $(seq 1 30); do
    [ -b "$disk" ] && [ -b "${disk}boot0" ] && [ -b "${disk}boot1" ] && break
    sleep 1
done
test -b "$disk" || fatal 'missing eMMC'
test "$(cat /sys/class/block/mmcblk2/device/name)" = 8WPD3R || fatal 'wrong eMMC model'
for node in "$disk" "${disk}boot0" "${disk}boot1" "$disk"p[0-9]*; do
    [ -b "$node" ] || continue
    blockdev --setro "$node" || fatal "cannot lock $node"
    test "$(blockdev --getro "$node")" = 1 || fatal "unlocked $node"
done
for region in boot0 boot1; do
    test -b "$disk$region" || fatal "missing $region"
    test "$(cat /sys/class/block/mmcblk2$region/force_ro)" = 1 || fatal "unlocked $region"
done
cp /usr/libexec/pb626-restore-fast.sh /run/pb626-restore-fast.sh
cp /usr/libexec/pb626-restore-scan /run/pb626-restore-scan
/bin/sh /run/pb626-restore-fast.sh probe >/run/board-id || fatal 'board preflight failed'
mount -t configfs configfs /sys/kernel/config || fatal configfs
g=/sys/kernel/config/usb_gadget/pb626
mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409" "$g/functions/acm.usb0" || fatal gadget
echo 0x0525 >"$g/idVendor"
echo 0xa4a7 >"$g/idProduct"
echo 0x02 >"$g/bDeviceClass"
echo 0x02 >"$g/bDeviceSubClass"
echo PB626RECOVERY >"$g/strings/0x409/serialnumber"
echo PocketBook >"$g/strings/0x409/manufacturer"
echo 'PB626 Debian recovery' >"$g/strings/0x409/product"
echo 'ACM recovery' >"$g/configs/c.1/strings/0x409/configuration"
ln -s "$g/functions/acm.usb0" "$g/configs/c.1/acm.usb0"
bound=no
for n in $(seq 1 30); do
    for udc in /sys/class/udc/*; do
        [ -d "$udc" ] || continue
        if echo "${udc##*/}" >"$g/UDC"; then bound=yes; break; fi
    done
    [ "$bound" = no ] || break
    sleep 1
done
test "$bound" = yes || fatal 'no UDC'
for led in /sys/class/leds/*; do
    [ -w "$led/trigger" ] && echo heartbeat >"$led/trigger" || :
done
cd /root
while :; do
    if [ -c /dev/ttyGS0 ]; then
        setsid -c sh -c 'printf "\r\nPB626 Debian 13 RAM recovery\r\n"; exec sh -i' </dev/ttyGS0 >/dev/ttyGS0 2>&1 || :
    fi
    sleep 1
done
