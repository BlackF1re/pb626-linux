#!/bin/sh
set -eu
xset s off
xsetroot -solid white
matchbox-window-manager -use_titlebar yes &
wm=$!
matchbox-keyboard --daemon us &
keyboard=$!
pb626-x11-epd "$1" "$2" &
screen=$!
matchbox-desktop --bg col-solid:white --font 'Sans bold 21px' \
    --fontcol black --no-outline --no-title --icon-size 56 --icon-padding 24 &
desktop=$!
trap 'kill "$wm" "$keyboard" "$screen" "$desktop" 2>/dev/null || true' EXIT
wait -n "$desktop" "$screen"
