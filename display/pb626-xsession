#!/bin/sh
set -eu
# Make HarfBuzz symbols available to FreeType's auto-hinter on musl.
if [ -r /usr/lib/libharfbuzz.so.0 ]; then
    export LD_PRELOAD="/usr/lib/libharfbuzz.so.0${LD_PRELOAD:+:$LD_PRELOAD}"
fi
xset s off
xsetroot -solid white
export XENVIRONMENT=/etc/pb626/Xresources
matchbox-window-manager -theme PB626 -use_titlebar yes &
wm=$!
panel=
if command -v matchbox-panel >/dev/null; then
    matchbox-panel --orientation south --size 48 --bgcolor white --no-session \
        --default-apps 'mb-applet-menu-launcher,mb-applet-launcher --desktop /etc/pb626/keyboard.desktop,mb-applet-battery,mb-applet-clock' &
    panel=$!
fi
matchbox-keyboard --daemon us &
keyboard=$!
screen=
if [ -z "${PB626_EPD_BRIDGE_PID:-}" ]; then
    pb626-x11-epd "$1" "$2" &
    screen=$!
fi
matchbox-desktop --bg col-solid:white --font 'Sans bold 18px' \
    --fontcol black --no-outline --no-title --icon-size 112 --icon-padding 8 &
desktop=$!
trap 'kill "$wm" "$keyboard" "$desktop" ${panel:+"$panel"} ${screen:+"$screen"} 2>/dev/null || true' EXIT
if [ -n "${PB626_EPD_BRIDGE_PID:-}" ]; then
    : > "${PB626_EPD_SESSION_STARTED:?}"
    (while kill -0 "$PB626_EPD_BRIDGE_PID" 2>/dev/null; do sleep 0.2; done) &
    screen=$!
fi
wait -n "$desktop" "$screen"
