+static int
+read_number(const char *path, int fallback)
+{
+  FILE *file = fopen(path, "r");
+  int value;
+
+  if (!file)
+    return fallback;
+
+  int result = fscanf(file, "%d", &value);
+  fclose(file);
+  return result == 1 ? value : fallback;
+}
+
+static int
+read_apm(int *values)
+{
+  values[TIME_LEFT] = 0;
+  values[PERCENTAGE] = read_number("/sys/class/power_supply/axp20x-battery/capacity", -1);
+  values[AC_POWER] = read_number("/sys/class/power_supply/axp20x-usb/online", 0);
+  return 1;
+}
+#elif defined(USE_ACPI_LINUX)
