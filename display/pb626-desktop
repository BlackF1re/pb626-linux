#!/bin/sh
set -eu

waveform=${1:-/run/default.wbf}
if [ ! -s "$waveform" ] ||
   [ ! -f /proc/device-tree/chosen/pb626,display-bringup ]; then
    echo 'Boot the ELAN display image and supply its factory waveform.' >&2
    exit 1
fi
waveform=$(realpath "$waveform")
umask 077
work=/run/pb626-desktop
mkdir "$work"
bridge_pid=
xinit_pid=
cleanup() {
    if [ -n "$xinit_pid" ]; then kill "$xinit_pid" 2>/dev/null || :; wait "$xinit_pid" || :; fi
    if [ -n "$bridge_pid" ]; then kill "$bridge_pid" 2>/dev/null || :; wait "$bridge_pid" || :; fi
    rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

# Bound the wait for late ELAN registration; USB and buttons remain usable.
for attempt in $(seq 1 20); do
    found=no
    for event in /sys/class/input/event*; do
        [ -r "$event/device/name" ] || continue
        case "$(cat "$event/device/name")" in
            *[Ee][Ll][Aa][Nn]*) [ ! -c "/dev/input/${event##*/}" ] || found=yes ;;
        esac
    done
    [ "$found" = no ] || break
    sleep 0.25
done
count=0
touch=no
button_devices=
power_device=
for event in /sys/class/input/event*; do
    [ -r "$event/device/name" ] && [ -c "/dev/input/${event##*/}" ] || continue
    name=$(cat "$event/device/name")
    case "$name" in
        *[Ee][Ll][Aa][Nn]*)
            touch=yes
            role=CorePointer
            ;;
        axp20x-pek)
            if [ -f /etc/debian_version ]; then power_device="/dev/input/${event##*/}"; fi
            continue ;;
        'GPIO Keys'|*.lradc)
            button_devices="$button_devices /dev/input/${event##*/}"
            continue
            ;;
        *) continue ;;
    esac
    count=$((count + 1))
    cat >>"$work/xorg.conf" <<EOF
Section "InputDevice"
    Identifier "input$count"
    Driver "evdev"
    Option "Device" "/dev/input/${event##*/}"
EndSection
EOF
    printf '    InputDevice "input%s" "%s"\n' "$count" "$role" >>"$work/layout"
done
cat /etc/pb626/xorg.conf >>"$work/xorg.conf"
printf 'Section "ServerLayout"\n    Identifier "PocketBook"\n    Screen "PocketBook"\n' >>"$work/xorg.conf"
if [ -f "$work/layout" ]; then
    cat "$work/layout" >>"$work/xorg.conf"
    rm "$work/layout"
fi
echo 'EndSection' >>"$work/xorg.conf"

export XAUTHORITY="$work/Xauthority"
export PB626_BUTTON_DEVICES="$button_devices"
if [ -n "$power_device" ]; then export PB626_POWER_DEVICE="$power_device"; fi
if [ "$touch" = no ]; then
    export PB626_POINTER_FALLBACK=1
    echo 'Touch unavailable. Left/Right move the pointer, Home changes axis, Menu clicks.'
fi
touch "$XAUTHORITY"
cookie=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
xauth add :0 MIT-MAGIC-COOKIE-1 "$cookie"
client=/usr/bin/pb626-xsession
if [ -f /proc/device-tree/chosen/pb626,emmc-root ]; then
    chgrp reader "$work" "$XAUTHORITY"
    chmod 750 "$work"
    chmod 640 "$XAUTHORITY"
    mkdir -m 700 "$work/session"
    chown reader:reader "$work/session"
    export XDG_RUNTIME_DIR="$work/session"
    export PB626_EPD_SESSION_STARTED="$work/session/clients.started"
    client=/usr/libexec/pb626-user-session
    if [ -f /etc/debian_version ]; then export PB626_SYSTEM_SLEEP=1; fi
    # Only the hardware bridge/worker inherit modest OOM protection.
    (printf '%s\n' -500 >/proc/self/oom_score_adj || :; exec env DISPLAY=:0 /usr/bin/pb626-x11-epd "$waveform" "$work/ready") &
    bridge_pid=$!
    export PB626_EPD_BRIDGE_PID="$bridge_pid"
fi
# Explicit compatibility override, normally use the packaged default depth.
# Only these two known TrueColor visuals are supported.
case ${PB626_XORG_DEPTH:-} in
    16|24) set -- -depth "$PB626_XORG_DEPTH" ;;
    '') set -- ;;
    *) echo 'PB626_XORG_DEPTH must be 16 or 24' >&2; exit 2 ;;
esac
xorg=/usr/bin/Xorg
if [ -f /etc/debian_version ] && [ -x /usr/lib/xorg/Xorg ]; then
    xorg=/usr/lib/xorg/Xorg
fi
xinit "$client" "$waveform" "$work/ready" -- \
    "$xorg" :0 vt2 -nolisten tcp -nocursor -auth "$XAUTHORITY" "$@" \
    -config "$work/xorg.conf" -logfile /run/pb626-xorg.log &
xinit_pid=$!
if [ -f /etc/debian_version ] && [ -n "$bridge_pid" ]; then
    # Debian runs this wrapper under Bash; no periodic process polling.
    wait -n "$xinit_pid" "$bridge_pid"
else
    wait "$xinit_pid"
fi
