#!/bin/sh
set -eu

# Read a single profile name, never source a configuration file as shell code.
# An explicit environment override is useful for RAM and diagnostic sessions.
if [ -z "${PB626_EPD_GRAY_PROFILE:-}" ]; then
    profile=mono
    if [ -r /etc/pb626/display-profile ]; then
        IFS= read -r profile </etc/pb626/display-profile || true
    fi
    case "$profile" in
        mono|balanced|ui|photo|legacy) ;;
        *) echo "PB626: invalid display profile; using mono" >&2; profile=mono ;;
    esac
    export PB626_EPD_GRAY_PROFILE="$profile"
fi
# CLI applications that support these conventions should avoid ANSI colors.
export NO_COLOR=1 CLICOLOR=0
waveform=${1:-/run/default.wbf}
if [ ! -s "$waveform" ] ||
   [ ! -f /proc/device-tree/chosen/pb626,display-bringup ]; then
    echo 'Boot the ELAN display image and supply its factory waveform.' >&2
    exit 1
fi
waveform=$(realpath "$waveform")
umask 077
work=/run/pb626-desktop
mkdir "$work"
bridge_pid=
trap 'if [ -n "$bridge_pid" ]; then kill "$bridge_pid" 2>/dev/null || :; wait "$bridge_pid" || :; fi; rm -f "$work"/Xauthority "$work"/xorg.conf "$work"/ready "$work"/layout "$work"/clients.started; rmdir "$work"' EXIT
trap 'exit 1' HUP INT TERM

count=0
touch=no
button_devices=
for event in /sys/class/input/event*; do
    [ -r "$event/device/name" ] || continue
    name=$(cat "$event/device/name")
    case "$name" in
        *[Ee][Ll][Aa][Nn]*)
            touch=yes
            role=CorePointer
            ;;
        'GPIO Keys'|*.lradc)
            button_devices="$button_devices /dev/input/${event##*/}"
            continue
            ;;
        *) continue ;;
    esac
    count=$((count + 1))
    cat >>"$work/xorg.conf" <<EOF
Section "InputDevice"
    Identifier "input$count"
    Driver "evdev"
    Option "Device" "/dev/input/${event##*/}"
EndSection
EOF
    printf '    InputDevice "input%s" "%s"\n' "$count" "$role" >>"$work/layout"
done
cat /etc/pb626/xorg.conf >>"$work/xorg.conf"
printf 'Section "ServerLayout"\n    Identifier "PocketBook"\n    Screen "PocketBook"\n' >>"$work/xorg.conf"
if [ -f "$work/layout" ]; then
    cat "$work/layout" >>"$work/xorg.conf"
    rm "$work/layout"
fi
echo 'EndSection' >>"$work/xorg.conf"

export XAUTHORITY="$work/Xauthority"
export PB626_BUTTON_DEVICES="$button_devices"
if [ "$touch" = no ]; then
    export PB626_POINTER_FALLBACK=1
    echo 'Touch unavailable. Left/Right move the pointer, Home changes axis, Menu clicks.'
fi
touch "$XAUTHORITY"
cookie=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
xauth add :0 MIT-MAGIC-COOKIE-1 "$cookie"
if [ -f /proc/device-tree/chosen/pb626,emmc-root ]; then
    export PB626_EPD_SESSION_STARTED="$work/clients.started"
    DISPLAY=:0 /usr/bin/pb626-x11-epd "$waveform" "$work/ready" &
    bridge_pid=$!
    export PB626_EPD_BRIDGE_PID="$bridge_pid"
fi
xinit /usr/bin/pb626-xsession "$waveform" "$work/ready" -- \
    /usr/bin/Xorg :0 vt2 -nolisten tcp -nocursor -auth "$XAUTHORITY" \
    -config "$work/xorg.conf" -logfile /run/pb626-xorg.log
