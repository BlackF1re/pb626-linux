<?xml version="1.0" encoding="UTF-8"?>
<!-- PB626 mobile QWERTY with a number row and a secondary symbol/navigation
     layer. Matchbox 0.1.1 supports a single flat layout and one-shot modifiers.
     Retain terminal navigation and Ctrl/Alt without a separate desktop layout.
     Based on the upstream US layout by Matt Reimer. -->
<keyboard>
  <options/>
  <layout id="default keyboard">
    <row>
      <key>
        <default display="1"/>
        <shifted display="!"/>
        <mod1 display="Esc" action="escape"/>
      </key>
      <key>
        <default display="2"/>
        <shifted display="@"/>
        <mod1 display="Tab" action="tab"/>
      </key>
      <key>
        <default display="3"/>
        <shifted display="#"/>
        <mod1 display="Home" action="home"/>
      </key>
      <key>
        <default display="4"/>
        <shifted display="$"/>
        <mod1 display="PgUp" action="pageup"/>
      </key>
      <key>
        <default display="5"/>
        <shifted display="%"/>
        <mod1 display="End" action="end"/>
      </key>
      <key>
        <default display="6"/>
        <shifted display="^"/>
        <mod1 display="PgDn" action="pagedown"/>
      </key>
      <key>
        <default display="7"/>
        <shifted display="&amp;"/>
        <mod1 display="←" action="left"/>
      </key>
      <key>
        <default display="8"/>
        <shifted display="*"/>
        <mod1 display="↓" action="down"/>
      </key>
      <key>
        <default display="9"/>
        <shifted display="("/>
        <mod1 display="↑" action="up"/>
      </key>
      <key>
        <default display="0"/>
        <shifted display=")"/>
        <mod1 display="→" action="right"/>
      </key>
    </row>
    <row>
      <key obey-caps="true">
        <default display="q"/>
        <shifted display="Q"/>
        <mod1 display="["/>
      </key>
      <key obey-caps="true">
        <default display="w"/>
        <shifted display="W"/>
        <mod1 display="]"/>
      </key>
      <key obey-caps="true">
        <default display="e"/>
        <shifted display="E"/>
        <mod1 display="{"/>
      </key>
      <key obey-caps="true">
        <default display="r"/>
        <shifted display="R"/>
        <mod1 display="}"/>
      </key>
      <key obey-caps="true">
        <default display="t"/>
        <shifted display="T"/>
        <mod1 display="\"/>
      </key>
      <key obey-caps="true">
        <default display="y"/>
        <shifted display="Y"/>
        <mod1 display="|"/>
      </key>
      <key obey-caps="true">
        <default display="u"/>
        <shifted display="U"/>
        <mod1 display="`"/>
      </key>
      <key obey-caps="true">
        <default display="i"/>
        <shifted display="I"/>
        <mod1 display="~"/>
      </key>
      <key obey-caps="true">
        <default display="o"/>
        <shifted display="O"/>
        <mod1 display="-"/>
      </key>
      <key obey-caps="true">
        <default display="p"/>
        <shifted display="P"/>
        <mod1 display="_"/>
      </key>
    </row>
    <row>
      <space width="500"/>
      <key obey-caps="true">
        <default display="a"/>
        <shifted display="A"/>
        <mod1 display="="/>
      </key>
      <key obey-caps="true">
        <default display="s"/>
        <shifted display="S"/>
        <mod1 display="+"/>
      </key>
      <key obey-caps="true">
        <default display="d"/>
        <shifted display="D"/>
        <mod1 display=";"/>
      </key>
      <key obey-caps="true">
        <default display="f"/>
        <shifted display="F"/>
        <mod1 display=":"/>
      </key>
      <key obey-caps="true">
        <default display="g"/>
        <shifted display="G"/>
        <mod1 display="'"/>
      </key>
      <key obey-caps="true">
        <default display="h"/>
        <shifted display="H"/>
        <mod1 display="&quot;"/>
      </key>
      <key obey-caps="true">
        <default display="j"/>
        <shifted display="J"/>
        <mod1 display="/"/>
      </key>
      <key obey-caps="true">
        <default display="k"/>
        <shifted display="K"/>
        <mod1 display="?"/>
      </key>
      <key obey-caps="true">
        <default display="l"/>
        <shifted display="L"/>
        <mod1 display="@"/>
      </key>
      <space width="500"/>
    </row>
    <row>
      <key fill="true" width="1500">
        <default display="Shift" action="modifier:shift"/>
        <shifted display="Shift" action="modifier:shift"/>
        <mod1 display="Shift" action="modifier:shift"/>
      </key>
      <key obey-caps="true">
        <default display="z"/>
        <shifted display="Z"/>
        <mod1 display="ä"/>
      </key>
      <key obey-caps="true">
        <default display="x"/>
        <shifted display="X"/>
        <mod1 display="ë"/>
      </key>
      <key obey-caps="true">
        <default display="c"/>
        <shifted display="C"/>
        <mod1 display="ö"/>
      </key>
      <key obey-caps="true">
        <default display="v"/>
        <shifted display="V"/>
        <mod1 display="½"/>
      </key>
      <key obey-caps="true">
        <default display="b"/>
        <shifted display="B"/>
        <mod1 display="¾"/>
      </key>
      <key obey-caps="true">
        <default display="n"/>
        <shifted display="N"/>
        <mod1 display="&lt;"/>
      </key>
      <key obey-caps="true">
        <default display="m"/>
        <shifted display="M"/>
        <mod1 display="&gt;"/>
      </key>
      <key fill="true" width="1500">
        <default display="Bksp" action="backspace"/>
        <shifted display="Bksp" action="backspace"/>
        <mod1 display="Del" action="delete"/>
      </key>
    </row>
    <row>
      <key width="1500">
        <default display="#+=" action="modifier:mod1"/>
        <shifted display="#+=" action="modifier:mod1"/>
        <mod1 display="ABC" action="modifier:mod1"/>
      </key>
      <key>
        <default display="Ctrl" action="modifier:ctrl"/>
        <mod1 display="Ctrl" action="modifier:ctrl"/>
      </key>
      <key>
        <default display=","/>
        <shifted display="&lt;"/>
        <mod1 display=","/>
      </key>
      <key width="4000" fill="true">
        <default display=" " action="space"/>
        <shifted display=" " action="space"/>
        <mod1 display=" " action="space"/>
      </key>
      <key>
        <default display="."/>
        <shifted display="&gt;"/>
        <mod1 display="."/>
      </key>
      <key>
        <default display="Alt" action="modifier:alt"/>
        <mod1 display="Alt" action="modifier:alt"/>
      </key>
      <key width="1500">
        <default display="Enter" action="return"/>
        <shifted display="Enter" action="return"/>
        <mod1 display="Enter" action="return"/>
      </key>
    </row>
  </layout>
</keyboard>
