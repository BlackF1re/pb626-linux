#!/usr/bin/wish
# On-demand, touch-oriented control centre. No resident settings daemon.
tk_setPalette background white foreground black activeBackground #cccccc \
    activeForeground black selectBackground black selectForeground white
option add *Font {{Liberation Sans} 15}
option add *Button.padY 10
option add *Button.padX 14
option add *Button.anchor w
option add *Button.relief solid
option add *Button.borderWidth 1
option add *Button.activeBackground black
option add *Button.activeForeground white
option add *Menubutton.relief solid
option add *Menubutton.borderWidth 1
option add *Menu.activeBackground black
option add *Menu.activeForeground white
option add *Menu.tearOff 0
option add *Scale.sliderLength 40
option add *highlightColor black
ttk::style theme use clam
ttk::style configure TNotebook -background white -borderwidth 0
ttk::style configure TNotebook.Tab -padding {10 12} -font {{Liberation Sans} 14 bold} -foreground black -background white -borderwidth 1
ttk::style map TNotebook.Tab -background {selected black active #eeeeee} -foreground {selected white}
wm title . "PocketBook Settings"
wm geometry . 700x840

proc section {parent name title {description ""}} {
    frame $parent.$name -background white
    frame $parent.$name.line -height 1 -background black
    label $parent.$name.title -text $title -anchor w -font {{Liberation Sans} 19 bold}
    pack $parent.$name.line -fill x -pady {12 7}
    pack $parent.$name.title -fill x
    if {$description ne ""} {
        label $parent.$name.description -text $description -anchor w -justify left -wraplength 540 -font {{Liberation Sans} 12}
        pack $parent.$name.description -fill x -pady {2 4}
    }
    pack $parent.$name -fill x -padx 16 -pady {3 6}
}
proc gear {canvas} {
    set points {}
    for {set i 0} {$i < 32} {incr i} {
        set radius [expr {$i % 4 in {1 2} ? 19.0 : 15.0}]
        set angle [expr {$i * 2.0 * acos(-1) / 32}]
        lappend points [expr {22 + $radius*cos($angle)}] [expr {22 + $radius*sin($angle)}]
    }
    $canvas create polygon $points -fill black -outline black
    $canvas create oval 13 13 31 31 -fill white -outline white
}
proc readfile {path} {
    if {[catch {set fd [open $path r]}]} {return ""}
    set failed [catch {set value [string trim [read $fd]]}]
    catch {close $fd}
    if {$failed} {return ""}
    return $value
}
proc query {args} {
    if {[catch {exec /usr/bin/timeout -k 2s 15s /usr/bin/doas /usr/sbin/pb626-admin {*}$args 2>@1} result]} {
        tk_messageBox -icon error -title "Operation failed" -message $result
        return -code error $result
    }
    return $result
}
proc act {args} {
    return [expr {![catch {query {*}$args}]}]
}
proc term {title args} {
    if {[catch {exec xterm -T $title -e {*}$args &} err]} {
        tk_messageBox -icon error -message $err
    }
}
proc choose {parent name caption variable choices} {
    frame $parent.$name
    label $parent.$name.label -text $caption -anchor w -justify left
    tk_optionMenu $parent.$name.select $variable {*}$choices
    $parent.$name.select configure -width 13 -anchor w -padx 12 -pady 9
    pack $parent.$name.label -fill x -pady {0 3}
    pack $parent.$name.select -fill x
    pack $parent.$name -fill x -padx 16 -pady 5
}
proc lightRefresh {} {
    global level lightState lightText
    if {![catch {query light-status} result]} {
        lassign $result lightState level
        set lightText [expr {$lightState ? "Frontlight on" : "Frontlight off"}]
    }
}
proc lightApply {} {
    global level
    if {[act light-level $level]} {lightRefresh}
}
proc lightSwitch {action} {
    if {[act $action]} {lightRefresh}
}
proc networkStatus {} {
    set up 0
    set networks {}
    foreach p [glob -nocomplain /sys/class/net/*] {
        if {![file isdirectory $p/wireless] && ![file exists $p/phy80211]} {continue}
        set state [readfile $p/operstate]
        if {$state eq "up"} {set up 1}
        lappend networks "[file tail $p]: $state"
    }
    if {![llength $networks]} {
        set ::networkText "No wireless interface detected."
    } else {
        set ::networkText "[expr {$up ? "Connected / link up" : "Not connected"}] — [join $networks {, }]"
    }
}
proc wifi {} {
    if {[act wifi-on]} {
        networkStatus
        if {[catch {exec /usr/bin/iwgtk -N &} err]} {
            tk_messageBox -icon error -message $err
        }
    }
}
proc bindingsSelect {} {
    set key [lsearch -exact {Left Right Home Menu} $::bindingKey]
    if {$key < 0} {return}
    foreach {gesture offset} {short 0 long 1 double 2} {
        set i [expr {3*$key+$offset}]
        .bindings.$gesture.select configure -textvariable ::bindAction($i)
        set m .bindings.$gesture.select.menu
        $m delete 0 end
        foreach action $::bindingActions {
            $m add radiobutton -label $action -variable ::bindAction($i) -value $action
        }
    }
}
proc bindingsSave {} {
    set values {}
    for {set i 0} {$i < 12} {incr i} {lappend values $::bindAction($i)}
    if {[act button-bindings {*}$values]} {
        destroy .bindings
        set ::restartNeeded 1
        set ::feedback "Bindings saved. Restart desktop to apply."
    }
}
proc buttonSettings {} {
    if {[winfo exists .bindings]} {raise .bindings; return}
    if {[catch {query button-bindings-status} data] || [llength $data] != 12} {return}
    set ::bindingActions {none Left Right Up Down Page_Up Page_Down Home End Escape Return BackSpace Tab space Menu F1 F2 F3 F4 F5 F6 F7 F8 F9 F10 F11 F12 keyboard refresh light-toggle recent-apps}
    for {set i 0} {$i < 12} {incr i} {set ::bindAction($i) [lindex $data $i]}
    set ::bindingKey Left
    toplevel .bindings
    wm title .bindings "Physical button bindings"
    wm transient .bindings .
    label .bindings.note -text "Choose a button, then set each gesture. Double-click delays the single press only when assigned." -anchor w -justify left -wraplength 450
    pack .bindings.note -fill x -padx 16 -pady 8
    choose .bindings key "Physical button" bindingKey {Left Right Home Menu}
    .bindings.key.select.menu delete 0 end
    foreach key {Left Right Home Menu} {
        .bindings.key.select.menu add command -label $key -command [list setBindingKey $key]
    }
    foreach {gesture caption index} {short "Short press" 0 long "Long press" 1 double "Double press" 2} {
        choose .bindings $gesture $caption ::bindAction($index) $::bindingActions
    }
    button .bindings.save -text "Save all bindings" -command bindingsSave
    button .bindings.reset -text "Restore defaults" -command {
        if {[tk_messageBox -parent .bindings -type yesno -message "Restore default bindings for all four buttons?"] eq "yes" &&
            [act button-bindings-reset]} {
            destroy .bindings
            set ::restartNeeded 1
            set ::feedback "Defaults restored. Restart desktop to apply."
        }
    }
    button .bindings.cancel -text "Cancel" -command {destroy .bindings}
    pack .bindings.save .bindings.reset .bindings.cancel -fill x -padx 16 -pady 4
    bindingsSelect
}
proc setBindingKey {key} {
    set ::bindingKey $key
    bindingsSelect
}
proc batterySummary {} {
    set value "Battery telemetry unavailable."
    foreach p [glob -nocomplain /sys/class/power_supply/*] {
        if {[readfile $p/type] ne "Battery"} {continue}
        set capacity [readfile $p/capacity]
        set status [readfile $p/status]
        if {[string is integer -strict $capacity] && $capacity >= 0 && $capacity <= 100} {
            set value "$capacity% — $status"
        }
        break
    }
    set ::batteryText $value
}
proc storageSummary {} {
    if {![catch {query sd-status} result]} {set ::storageText $result}
}
proc batterySettings {} {
    if {[winfo exists .battery]} {raise .battery; return}
    if {[catch {query battery-status} result]} {return}
    lassign $result ::batteryWarn ::batteryCritical
    toplevel .battery
    wm title .battery "Battery policy"
    label .battery.note -text "Warning and shutdown while discharging only.\nShutdown requires two confirmed low samples." -justify left
    pack .battery.note -pady 8
    set warnings {}
    for {set i 5} {$i <= 30} {incr i} {lappend warnings $i}
    choose .battery warn "Warn at (%)" batteryWarn $warnings
    choose .battery critical "Shut down at (%)" batteryCritical {2 3 4 5 6 7 8 9 10}
    set ::batteryMessage "Warning must be higher than shutdown."
    label .battery.message -textvariable ::batteryMessage -anchor w -justify left -wraplength 420
    button .battery.save -text "Save battery policy" -command {
        if {$::batteryWarn <= $::batteryCritical} {
            set ::batteryMessage "Choose a warning threshold above shutdown."
        } elseif {[act battery-settings $::batteryWarn $::batteryCritical]} {
            destroy .battery
            set ::feedback "Battery policy saved."
        }
    }
    button .battery.cancel -text "Cancel" -command {destroy .battery}
    pack .battery.message .battery.save .battery.cancel -fill x -padx 12 -pady 4
}
proc shutdownPicker {} {
    if {[catch {exec /usr/bin/pb626-shutdown-picker &} err]} {
        tk_messageBox -icon error -message $err
    }
}
proc power {action} {
    if {[tk_messageBox -type yesno -icon question -message "Really $action the reader?"] eq "yes"} {
        act $action
    }
}
proc updateStatus {} {
    set data ""
    foreach p [glob -nocomplain /sys/class/power_supply/*] {
        append data "[file tail $p]: [readfile $p/type]"
        foreach field {capacity status online voltage_now current_now} {
            set v [readfile $p/$field]
            if {$v ne ""} {append data " $field=$v"}
        }
        append data "\n"
    }
    foreach p [glob -nocomplain /sys/class/thermal/thermal_zone*] {
        append data "[readfile $p/type]: [readfile $p/temp] mC\n"
    }
    foreach p [glob -nocomplain /sys/class/rtc/rtc*] {
        append data "RTC [file tail $p]: [readfile $p/date] [readfile $p/time]\n"
    }
    foreach p [glob -nocomplain /sys/class/backlight/*] {
        append data "Frontlight [file tail $p]: [readfile $p/brightness]/[readfile $p/max_brightness]\n"
    }
    foreach p [glob -nocomplain /sys/class/leds/*] {
        append data "LED [file tail $p]: [readfile $p/brightness]\n"
    }
    foreach cmd {{free -m} {df -h /} {date} {timedatectl status} {systemctl --no-pager --failed} {rfkill list}} {
        if {![catch {exec /usr/bin/timeout -k 1s 3s {*}$cmd 2>@1} result]} {append data "$result\n"} else {append data "[lindex $cmd 0]: unavailable\n"}
    }
    .tabs.system.canvas.body.info configure -state normal
    .tabs.system.canvas.body.info delete 1.0 end
    .tabs.system.canvas.body.info insert end $data
    set lines [expr {[llength [split $data "\n"]] + 2}]
    .tabs.system.canvas.body.info configure -state disabled -height [expr {max(12, $lines)}]
}
proc desktopApply {section} {
    global buttons home menu gray depth idle fast tone gamma preview mixed holdMs uiDpi panelSize titlebarSize taskbarEnabled taskbarSize feedback restartNeeded
    switch -- $section {
        display {
            if {$preview && $mixed} {
                set feedback "Choose either exact mixed rendering or approximate preview."
                return
            }
            set ok [act desktop-display $gray $depth $fast $tone $gamma $preview $mixed]
        }
        keys {set ok [act desktop-buttons $buttons $home $menu]}
        idle {set ok [act desktop-idle $idle]}
        hold {set ok [act desktop-hold $holdMs]}
        dpi {set ok [act desktop-dpi $uiDpi]}
        appearance {set ok [act desktop-appearance $panelSize $titlebarSize]}
        taskbar {set ok [act desktop-taskbar $taskbarEnabled $taskbarSize]}
        default {error "Unknown settings section"}
    }
    if {$ok} {
        set restartNeeded 1
        set feedback "Saved. Restart desktop to apply."
    }
}
proc timeSummary {} {
    set stamp [clock format [clock seconds] -format "%Y-%m-%d %H:%M"]
    set zone [readfile /etc/timezone]
    if {$zone eq "" && ![catch {exec /usr/bin/timeout -k 1s 3s timedatectl show -p Timezone --value} result]} {
        set zone [string trim $result]
    }
    set ntpState unknown
    if {![catch {exec /usr/bin/timeout -k 1s 3s timedatectl show -p NTP --value} result]} {
        if {$result eq "yes"} {set ntpState on}
        if {$result eq "no"} {set ntpState off}
    }
    set ::timeText "$stamp   $zone\nAutomatic time: $ntpState"
}
proc manualTime {} {
    if {[winfo exists .manualtime]} {raise .manualtime; return}
    set ::manualDate [clock format [clock seconds] -format "%Y-%m-%d"]
    set ::manualClock [clock format [clock seconds] -format "%H:%M:%S"]
    toplevel .manualtime
    wm title .manualtime "Set date and time"
    wm transient .manualtime .
    label .manualtime.note -text "Turn automatic time off before setting the clock manually." -anchor w -justify left -wraplength 450
    label .manualtime.dlabel -text "Date (YYYY-MM-DD)" -anchor w
    entry .manualtime.date -textvariable ::manualDate
    label .manualtime.tlabel -text "Local time (HH:MM:SS)" -anchor w
    entry .manualtime.time -textvariable ::manualClock
    button .manualtime.save -text "Save date and time" -command {
        if {[act manual-time $::manualDate $::manualClock]} {
            destroy .manualtime
            timeSummary
            set ::feedback "Date and time saved."
        }
    }
    button .manualtime.cancel -text "Cancel" -command {destroy .manualtime}
    pack .manualtime.note .manualtime.dlabel .manualtime.date .manualtime.tlabel .manualtime.time .manualtime.save .manualtime.cancel -fill x -padx 16 -pady 4
}
proc timezoneFilter {} {
    if {![winfo exists .timezone.list]} {return}
    .timezone.list delete 0 end
    foreach z $::zones {
        if {[string first [string tolower $::zoneFilter] [string tolower $z]] >= 0} {
            .timezone.list insert end $z
        }
    }
}
proc timezoneSave {} {
    set chosen [.timezone.list curselection]
    if {![llength $chosen]} {set ::zoneMessage "Select a time zone first."; return}
    set z [.timezone.list get [lindex $chosen 0]]
    if {[act timezone $z]} {
        destroy .timezone
        set ::feedback "Time zone saved: $z"
        timeSummary
    }
}
proc timezoneDialog {} {
    if {[winfo exists .timezone]} {raise .timezone; return}
    if {[catch {exec /usr/bin/timeout -k 1s 5s timedatectl list-timezones} result]} {
        set ::feedback "Cannot read available time zones."
        return
    }
    set ::zones [split [string trim $result] "\n"]
    set ::zoneFilter ""
    set ::zoneMessage "Select the local time zone."
    toplevel .timezone
    wm title .timezone "Time zone"
    label .timezone.h -text "Find your time zone" -anchor w -font {{Liberation Sans} 18 bold}
    entry .timezone.search -textvariable ::zoneFilter
    bind .timezone.search <KeyRelease> {timezoneFilter}
    frame .timezone.results
    listbox .timezone.list -height 8 -exportselection 0 -yscrollcommand {.timezone.results.scroll set}
    # Keep the list a child of the dialog for simple testable bindings.
    scrollbar .timezone.results.scroll -width 32 -command {.timezone.list yview}
    pack .timezone.results.scroll -side right -fill y
    pack .timezone.list -in .timezone.results -side left -fill both -expand 1
    label .timezone.message -textvariable ::zoneMessage -anchor w
    button .timezone.save -text "Save time zone" -command timezoneSave
    button .timezone.cancel -text "Cancel" -command {destroy .timezone}
    pack .timezone.h .timezone.search -fill x -padx 12 -pady 5
    pack .timezone.results -fill both -expand 1 -padx 12 -pady 5
    pack .timezone.message .timezone.save .timezone.cancel -fill x -padx 12 -pady 4
    timezoneFilter
    focus .timezone.search
}
proc desktopRestart {} {
    if {[tk_messageBox -type yesno -icon question -message "Close all graphical applications and restart the desktop?"] eq "yes"} {
        act restart-desktop
    }
}
set buttons arrows
