set p .tabs.keys.canvas.body
section $p basic "Physical buttons" "Choose short-press defaults or configure individual gestures below."
choose $p arrows "Left / Right" buttons {arrows pages}
choose $p home "Home button" home {keyboard home}
choose $p menu "Menu short press" menu {menu escape}
label $p.note -text "Advanced bindings override these defaults. By default, hold Home for running apps and Menu for a full refresh.\nWithout touch, hardware pointer controls remain available." -anchor w -justify left -wraplength 560
pack $p.note -fill x -padx 16 -pady 10
choose $p hold "Long press duration (ms)" holdMs {300 500 750 1000 1500 2000}
button $p.holdsave -text "Save hold duration" -command {desktopApply hold}
pack $p.holdsave -fill x -padx 12 -pady 5
button $p.bindings -text "Advanced button bindings…" -command buttonSettings
pack $p.bindings -fill x -padx 12 -pady 5
button $p.save -text "Save button settings" -command {desktopApply keys}
button $p.restart -text "Restart desktop" -command desktopRestart
pack $p.save $p.restart -fill x -padx 12 -pady 5

set p .tabs.net.canvas.body
section $p wireless "Wireless network" "Turn Wi-Fi on and connect to a saved or new network."
set networkText "Wireless status not yet checked."
label $p.status -textvariable networkText -anchor w -justify left -wraplength 520
pack $p.status -fill x -padx 16 -pady 5
button $p.refresh -text "Refresh connection status" -command networkStatus
pack $p.refresh -fill x -padx 12 -pady 4
button $p.on -text "Wi-Fi networks (iwgtk)" -command wifi
button $p.off -text "Turn Wi-Fi off" -command {if {[act wifi-off]} {networkStatus; set feedback "Wi-Fi disabled."}}
button $p.cli -text "Wi-Fi terminal (iwctl)" -command {if {[act wifi-on]} {term "Wi-Fi" iwctl}}
button $p.dns -text "Network and DNS status" -command {term "Network status" sh -c {ip address; ip route; resolvectl status; read -r x}}
foreach w {on off cli dns} {pack $p.$w -fill x -padx 12 -pady 7}

set p .tabs.power.canvas.body
section $p energy "Energy and performance" "Manage the indicator and CPU frequency policy."
if {$ledMode ne "unavailable"} {
    choose $p led "Power indicator" ledMode {heartbeat on off}
    button $p.ledapply -text "Save indicator state" -command {act led $ledMode}
    pack $p.ledapply -fill x -padx 12 -pady 4
}
if {[llength $governors]} {
    choose $p cpu "CPU governor" governor $governors
    button $p.cpuapply -text "Apply CPU policy and save" -command {act governor $governor}
    pack $p.cpuapply -fill x -padx 12 -pady 4
    if {[string is integer -strict $cpuMin] && [string is integer -strict $cpuMax]} {
        label $p.cpufreq -text "Allowed range: [expr {$cpuMin / 1000}]–[expr {$cpuMax / 1000}] MHz"
        pack $p.cpufreq -fill x -padx 16 -pady 2
    }
}
section $p sleepSection "Power button and sleep"
set keyChoices {lock ignore poweroff}
if {$qualified} {lappend keyChoices s2idle}
choose $p powerkey "Power key action" powerKey $keyChoices
button $p.keyapply -text "Save power key action" -command {if {[act power-key $powerKey]} {tk_messageBox -message "Saved; applies to the next short press."}}
pack $p.keyapply -fill x -padx 12 -pady 4
if {$qualified} {
    choose $p idle "Sleep after minutes (0 = never)" idle {0 5 10 15 30 60}
    button $p.idleapply -text "Save idle policy" -command {desktopApply idle}
    button $p.sleep -text "Suspend now" -command {power suspend}
    pack $p.idleapply $p.sleep -fill x -padx 12 -pady 4
} else {
    set idle 0
    label $p.sleepnote -text "Lock is available now. Real s2idle is disabled until wakeup is qualified; deep sleep needs a resume-aware SPL." -anchor w -wraplength 560 -justify left
    pack $p.sleepnote -fill x -padx 16 -pady 10
}
section $p batterySection "Battery protection"
set batteryText "Battery status not yet checked."
label $p.batteryStatus -textvariable batteryText -anchor w -justify left
pack $p.batteryStatus -fill x -padx 16 -pady 4
button $p.batteryRefresh -text "Refresh battery status" -command batterySummary
pack $p.batteryRefresh -fill x -padx 12 -pady 4
button $p.battery -text "Battery warning / shutdown…" -command batterySettings
pack $p.battery -fill x -padx 12 -pady 4
section $p shutdownSection "Restart and shut down" "Save open documents before restarting."
button $p.reboot -text "Restart reader" -command {power reboot}
button $p.off -text "Shut down" -command {power poweroff}
pack $p.reboot $p.off -fill x -padx 12 -pady 4

set p .tabs.system.canvas.body
section $p storageSection "Storage"
set storageText "SD status not yet checked."
label $p.storageStatus -textvariable storageText -anchor w -justify left -wraplength 520
pack $p.storageStatus -fill x -padx 16 -pady 4
frame $p.storage
button $p.storage.mount -text "Mount SD and open files" -command {if {[act sd-mount]} {storageSummary; term "External SD" mc -b /media/sdcard}}
button $p.storage.unmount -text "Eject SD safely" -command {if {[act sd-unmount]} {storageSummary; set feedback "SD card can be removed."}}
button $p.storage.status -text "Refresh SD status" -command storageSummary
pack $p.storage.mount $p.storage.unmount $p.storage.status -fill x -pady 3
pack $p.storage -fill x -padx 12 -pady 4
section $p identity "Device identity"
frame $p.host
label $p.host.label -text "Hostname" -anchor w
entry $p.host.entry -textvariable host -width 18
button $p.host.apply -text "Save hostname" -command {if {[act hostname $host]} {set feedback "Hostname saved."}}
pack $p.host.label $p.host.entry $p.host.apply -fill x -pady 3
pack $p.host -fill x -padx 16 -pady 4
section $p timeSection "Date and time"
set timeText "Time status not yet checked."
label $p.clock -textvariable timeText -anchor w -justify left -wraplength 520
pack $p.clock -fill x -padx 16 -pady 4
frame $p.ntp
button $p.ntp.on -text "Automatic time on" -command {if {[act ntp true]} {timeSummary}}
button $p.ntp.off -text "Automatic time off" -command {if {[act ntp false]} {timeSummary}}
pack $p.ntp.on $p.ntp.off -side left -fill x -expand 1 -padx 3
pack $p.ntp -fill x -padx 8 -pady 4
button $p.timezone -text "Choose time zone…" -command timezoneDialog
button $p.manualtime -text "Set date and time…" -command manualTime
pack $p.timezone $p.manualtime -fill x -padx 12 -pady 4
section $p administration "Administration"
button $p.admin -text "Administrator terminal" -command {term "Administrator login" su -}
button $p.refresh -text "Refresh system diagnostics" -command {timeSummary; updateStatus}
pack $p.admin $p.refresh -fill x -padx 12 -pady 4
section $p diagnostics "System diagnostics" "A read-only snapshot. Refresh when needed."
text $p.info -height 16 -wrap word -font {{Liberation Mono} 11} -background white -foreground black -state disabled -relief solid -borderwidth 1
pack $p.info -fill x -padx 16 -pady 5
label .feedback -textvariable feedback -anchor w -justify left -wraplength 620
pack .feedback -fill x -padx 16 -pady 4
button .close -text "Close settings" -command {destroy .}
pack .close -fill x -padx 12 -pady 8
lightRefresh
# No expensive status subprocesses on initial display. Refresh on demand
# or on first entering the System page.
set statusLoaded 0
bind .tabs <<NotebookTabChanged>> {
    if {[.tabs select] eq ".tabs.net"} {networkStatus}
    if {[.tabs select] eq ".tabs.power"} {batterySummary}
    if {[.tabs select] eq ".tabs.system" && !$::statusLoaded} {
        set ::statusLoaded 1
        after idle {storageSummary; timeSummary; updateStatus}
    }
}
