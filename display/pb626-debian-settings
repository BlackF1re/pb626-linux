ttk::notebook .tabs
# Fixed-size portrait layouts clip controls when the keyboard is visible
# or the screen is rotated. Each page has an independent touch-sized
# scrollbar; no animated/inertial redraws or periodic layout polling.
proc tabRegion {canvas} {
    $canvas configure -scrollregion [$canvas bbox all]
}
proc wrapLabels {parent width} {
    foreach w [winfo children $parent] {
        if {[winfo class $w] eq "Label" && [$w cget -wraplength] > 0} {
            $w configure -wraplength [expr {max(120, $width-36)}]
        }
        if {[winfo class $w] eq "Frame"} {wrapLabels $w $width}
    }
}
proc tabWidth {canvas item width} {
    $canvas itemconfigure $item -width $width
    wrapLabels $canvas.body $width
    tabRegion $canvas
}
foreach {tab title} {display Display keys Buttons net Network power Power system System} {
    set page .tabs.$tab
    frame $page -background white
    canvas $page.canvas -background white -highlightthickness 0 -borderwidth 0 -yscrollcommand [list $page.vscroll set] -yscrollincrement 20
    scrollbar $page.vscroll -orient vertical -width 32 -background black -activebackground black -troughcolor white -command [list $page.canvas yview]
    frame $page.canvas.body -background white
    set item [$page.canvas create window 0 0 -window $page.canvas.body -anchor nw]
    bind $page.canvas.body <Configure> [list tabRegion $page.canvas]
    bind $page.canvas <Configure> [list tabWidth $page.canvas $item %w]
    pack $page.vscroll -side right -fill y
    pack $page.canvas -side left -fill both -expand 1
    .tabs add $page -text $title
}
