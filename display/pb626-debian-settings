if {![catch {query desktop-status} data]} {
    foreach line [split $data "\n"] {
        if {![regexp {^([A-Z0-9_]+)=([a-z0-9.-]+)$} $line -> key value]} {continue}
        switch -- $key {
            PB626_BUTTONS {set buttons $value}
            PB626_TASKBAR {if {$value in {0 1}} {set taskbarEnabled $value}}
            PB626_TASKBAR_SIZE {if {$value in {32 40 48 56 64 72}} {set taskbarSize $value}}
            PB626_PANEL_SIZE {if {$value in {32 40 48 56 64 72}} {set panelSize $value}}
            PB626_TITLEBAR_SIZE {if {$value in {32 40 48 56 64}} {set titlebarSize $value}}
            PB626_UI_DPI {if {$value in {auto 96 120 144 168 192 216}} {set uiDpi $value}}
            PB626_BUTTON_HOLD_MS {if {$value in {300 500 750 1000 1500 2000}} {set holdMs $value}}
            PB626_HOME_KEY {set home $value}
            PB626_MENU_KEY {set menu $value}
            PB626_EPD_GRAY_PROFILE {set gray $value}
            PB626_EPD_FAST_MODE {set fast $value}
            PB626_XORG_DEPTH {set depth $value}
            PB626_IDLE_MINUTES {set idle $value}
            PB626_EPD_TONE {set tone $value}
            PB626_EPD_GAMMA {set gamma $value}
            PB626_EPD_APPROX_PREVIEW {if {$value in {0 1}} {set preview $value}}
            PB626_EPD_MIXED {if {$value in {0 1}} {set mixed $value}}
        }
    }
}
