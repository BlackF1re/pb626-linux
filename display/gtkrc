# Neutral defaults for GTK2 applications installed later; no engine dependency.
gtk-cursor-blink = 0
gtk-enable-animations = 0
style "pb626-paper" {
  fg[NORMAL] = "#000000"
  fg[ACTIVE] = "#000000"
  fg[PRELIGHT] = "#000000"
  fg[SELECTED] = "#ffffff"
  fg[INSENSITIVE] = "#444444"
  bg[NORMAL] = "#ffffff"
  bg[ACTIVE] = "#ffffff"
  bg[PRELIGHT] = "#ffffff"
  bg[SELECTED] = "#000000"
  bg[INSENSITIVE] = "#ffffff"
  text[NORMAL] = "#000000"
  text[ACTIVE] = "#000000"
  text[PRELIGHT] = "#000000"
  text[SELECTED] = "#ffffff"
  text[INSENSITIVE] = "#555555"
  base[NORMAL] = "#ffffff"
  base[ACTIVE] = "#ffffff"
  base[PRELIGHT] = "#ffffff"
  base[SELECTED] = "#000000"
  base[INSENSITIVE] = "#ffffff"
}
class "*" style "pb626-paper"
