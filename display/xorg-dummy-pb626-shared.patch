 /*
  * Driver data structures.
  */
-#include "dummy.h"
+#include "dummy.h"
+#include "pb626-ddx-fb.h"
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+/* The existing Xorg software pixmap is the sole backing store. */
+static void
+pb626_metadata(ScrnInfoPtr pScrn)
+{
+    DUMMYPtr d = DUMMYPTR(pScrn);
+    if (!d->pb626_map)
+        return;
+    struct pb626_ddx_fb *h = d->pb626_map;
+    h->width = pScrn->virtualX;
+    h->height = pScrn->virtualY;
+    h->stride = pScrn->displayWidth * (pScrn->bitsPerPixel / 8);
+    h->bpp = pScrn->bitsPerPixel;
+    h->depth = pScrn->depth;
+    h->red = pScrn->mask.red;
+    h->green = pScrn->mask.green;
+    h->blue = pScrn->mask.blue;
+}
+
+static void
+pb626_unmap(DUMMYPtr d)
+{
+    if (d->pb626_published)
+        unlink(PB626_DDX_FB_PATH);
+    else if (d->pb626_pending[0])
+        unlink(d->pb626_pending);
+    if (d->pb626_map)
+        munmap(d->pb626_map, d->pb626_length);
+    d->pb626_map = NULL;
+    d->pb626_published = FALSE;
+    d->pb626_pending[0] = 0;
+}
+
+static void *
+pb626_backing(ScrnInfoPtr pScrn)
+{
+    DUMMYPtr d = DUMMYPTR(pScrn);
+    size_t bytes = (size_t)pScrn->videoRam * 1024;
+    const char *enabled = getenv("PB626_DDX_SHARED");
+    if (!enabled || strcmp(enabled, "1") || pScrn->scrnIndex != 0 ||
+        geteuid() != 0 || !bytes || bytes > PB626_DDX_FB_MAX ||
+        (pScrn->bitsPerPixel != 16 && pScrn->bitsPerPixel != 32))
+        return calloc(1, bytes);
+    snprintf(d->pb626_pending, sizeof(d->pb626_pending),
+             PB626_DDX_FB_PATH ".XXXXXX");
+    int fd = mkstemp(d->pb626_pending);
+    if (fd < 0) {
+        d->pb626_pending[0] = 0;
+        return calloc(1, bytes);
+    }
+    d->pb626_length = PB626_DDX_FB_OFFSET + bytes;
+    if (fchmod(fd, 0600) == 0 && ftruncate(fd, d->pb626_length) == 0) {
+        void *map = mmap(NULL, d->pb626_length, PROT_READ | PROT_WRITE,
+                         MAP_SHARED, fd, 0);
+        if (map != MAP_FAILED)
+            d->pb626_map = map;
+    }
+    close(fd);
+    if (!d->pb626_map) {
+        pb626_unmap(d);
+        return calloc(1, bytes);
+    }
+    struct pb626_ddx_fb *h = d->pb626_map;
+    h->magic = PB626_DDX_FB_MAGIC;
+    h->version = PB626_DDX_FB_VERSION;
+    h->capacity = bytes;
+    pb626_metadata(pScrn);
+    return (char *)d->pb626_map + PB626_DDX_FB_OFFSET;
+}
 
