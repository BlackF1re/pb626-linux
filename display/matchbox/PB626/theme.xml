<?xml version="1.0"?>
<theme name="PB626" version="1.0" engine_version="1">
  <color id="paper" def="#ffffff"/>
  <color id="ink" def="#000000"/>
  <color id="select" def="#cccccc"/>
  <font id="titlefont" def="Sans bold 20px"/>
  <font id="menufont" def="Sans bold 16px"/>
  <pixmap id="close" filename="close.png"/>
  <pixmap id="menu" filename="menu.png"/>

  <frame id="main" height="40">
    <layer x="0" y="0" w="100%" h="100%" type="plain" color="paper"/>
    <layer x="0" y="38" w="100%" h="2" type="plain" color="ink"/>
    <layer x="42" y="0" w="100%-84" h="38" type="label"
           color="ink" justify="left" font="titlefont"/>
    <button x="4" y="0" w="32" h="38" action="menu">
      <active pixmap="menu"/><inactive pixmap="menu"/>
    </button>
    <button x="100%-36" y="0" w="32" h="38" action="close">
      <active pixmap="close"/><inactive pixmap="close"/>
    </button>
  </frame>
  <frame id="dialog" height="40">
    <layer x="0" y="0" w="100%" h="100%" type="plain" color="paper"/>
    <layer x="0" y="38" w="100%" h="2" type="plain" color="ink"/>
    <layer x="6" y="0" w="100%-48" h="38" type="label"
           color="ink" justify="left" font="titlefont"/>
    <button x="100%-36" y="0" w="32" h="38" action="close">
      <active pixmap="close"/><inactive pixmap="close"/>
    </button>
  </frame>
  <frame id="dialog-east" width="2">
    <layer x="0" y="0" w="100%" h="100%" type="plain" color="ink"/>
  </frame>
  <frame id="dialog-west" width="2">
    <layer x="0" y="0" w="100%" h="100%" type="plain" color="ink"/>
  </frame>
  <frame id="dialog-south" height="2">
    <layer x="0" y="0" w="100%" h="100%" type="plain" color="ink"/>
  </frame>
  <frame id="menu" border_north="2" border_south="2" border_west="2"
         border_east="2" font="menufont" highlight="select" color="ink">
    <layer x="0" y="0" w="100%" h="100%" type="plain" color="paper"/>
  </frame>
</theme>
