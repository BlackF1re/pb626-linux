@@ -37,5 +37,6 @@
 
 ENTRY(sun5i_standby_blob)
-	mov	r11, lr
+	/* Save the caller's callee-saved registers before touching DRAM. */
+	push	{r4-r11, r12, lr}
 
 	/* preload the TLB with the two device mappings */
@@ -43,12 +44,17 @@
 	ldr	r3, [r1]
 
-	/* disable all DRAM host ports */
