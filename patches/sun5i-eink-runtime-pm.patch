+/* The scan engine is stateless between streams. Restore safe parked
+ * hardware with panel rails off. Runtime callbacks must not take
+ * fop_lock, which VB2 holds when acquiring a runtime PM reference. */
+static int eink_hw_enable(struct eink_dev *eink)
+{
+	int ret, i;
+
+	ret = reset_control_deassert(eink->rstc);
+	if (ret)
+		return ret;
+	ret = clk_set_rate(eink->clks[1].clk, eink->timing.sclk_hz);
+	if (ret)
+		goto err_reset;
+	ret = clk_bulk_prepare_enable(eink->num_clks, eink->clks);
+	if (ret)
+		goto err_reset;
+	for (i = 0x800; i < 0x1000; i += 4)
+		regmap_write(eink->be_regs, i, 0);
+	regmap_write(eink->tcon_regs, SUN4I_TCON_GCTL_REG, 0);
+	regmap_write(eink->tcon_regs, SUN4I_TCON_GINT0_REG, 0);
+	regmap_write(eink->tcon_regs, SUN4I_TCON_GINT1_REG, 0);
+	regmap_write(eink->tcon_regs, SUN4I_TCON0_IO_TRI_REG, ~0);
+	ret = pinctrl_select_state(eink->pinctrl, eink->pinctrl_idle);
+	if (ret) {
+		clk_bulk_disable_unprepare(eink->num_clks, eink->clks);
+		goto err_reset;
+	}
+	return 0;
+
+err_reset:
+	reset_control_assert(eink->rstc);
+	return ret;
+}
+
+static int eink_runtime_suspend(struct device *dev)
+{
+	struct eink_dev *eink = dev_get_drvdata(dev);
+	int ret;
+
+	if (READ_ONCE(eink->state) != EINK_STREAM_OFF)
+		return -EBUSY;
+	disable_irq(eink->irq);
+	flush_workqueue(eink->wq);
+	ret = pinctrl_select_state(eink->pinctrl, eink->pinctrl_idle);
+	if (ret)
+		goto err_irq;
+	regmap_write(eink->tcon_regs, SUN4I_TCON0_IO_TRI_REG, ~0);
+	ret = eink_set_power(eink, false);
+	if (ret)
+		goto err_irq;
+	ret = reset_control_assert(eink->rstc);
+	if (ret)
+		goto err_irq;
+	clk_bulk_disable_unprepare(eink->num_clks, eink->clks);
+	return 0;
+
+err_irq:
+	enable_irq(eink->irq);
+	dev_err(dev, "failed to suspend E Ink hardware: %d\n", ret);
+	return ret;
+}
+
+static int eink_runtime_resume(struct device *dev)
+{
+	struct eink_dev *eink = dev_get_drvdata(dev);
+	int ret = eink_hw_enable(eink);
+
+	if (ret)
+		return ret;
+	enable_irq(eink->irq);
+	return 0;
+}
+
+static int eink_system_suspend(struct device *dev)
+{
+	struct eink_dev *eink = dev_get_drvdata(dev);
+
+	/* Never truncate an active waveform, including direct root sleep. */
+	if (vb2_is_streaming(&eink->queue))
+		return -EBUSY;
+	return pm_runtime_force_suspend(dev);
+}
+
+static const struct dev_pm_ops eink_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(eink_system_suspend, pm_runtime_force_resume)
+	RUNTIME_PM_OPS(eink_runtime_suspend, eink_runtime_resume, NULL)
+};
