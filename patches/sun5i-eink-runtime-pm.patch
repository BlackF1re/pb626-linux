+/* A persistent worker keeps its FD open and uses delayed Runtime PM.
+ * A standalone final update closes it: park immediately rather than
+ * asking userspace to guess a panel power-down delay. */
+static int eink_release(struct file *file)
+{
+	struct eink_dev *eink = video_drvdata(file);
+	int ret = vb2_fop_release(file);
+	int pm_ret;
+
+	if (ret)
+		return ret;
+	pm_ret = pm_runtime_suspend(eink->dev);
+	if (pm_ret < 0 && pm_ret != -EAGAIN && pm_ret != -EBUSY &&
+	    pm_ret != -EACCES)
+		dev_warn(eink->dev, "close could not park E Ink: %d\n", pm_ret);
+	return 0;
+}
