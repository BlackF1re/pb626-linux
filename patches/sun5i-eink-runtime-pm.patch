+static void eink_shutdown(struct platform_device *pdev)
+{
+	struct eink_dev *eink = platform_get_drvdata(pdev);
+	int ret;
+
+	/* device_shutdown() already drains runtime PM. Reuse the same
+	 * synchronous parking sequence as system suspend. */
+	ret = eink_system_suspend(eink->dev);
+	if (ret)
+		dev_err(eink->dev, "shutdown could not park E Ink: %d\n", ret);
+}
